{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "game/*": ["typings/game/*"],
      "arena/*": ["typings/season_4/*"]
    }
  },
  "include": ["src/**/*", "typings/**/*"]
}